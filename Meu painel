-- 10. AJUSTE DE ÁUDIO PRO
-- ==============================================
local function aplicarAjuste(som)
    if not audioAtivo then return end
    if som:IsA("Sound") then
        if som:FindFirstChild("Configurado") then return end
        
        local marcador = Instance.new("BoolValue")
        marcador.Name = "Configurado"
        marcador.Parent = som

        som.Volume = 1
        
        local eq = Instance.new("EqualizerSoundEffect")
        eq.Name = "CustomEQ"
        eq.LowGain = 5    
        eq.MidGain = -12  
        eq.HighGain = 5   
        eq.Parent = som
        
        local comp = Instance.new("CompressorSoundEffect")
        comp.Name = "CustomComp"
        comp.Threshold = -20
        comp.Ratio = 4
        comp.Attack = 0.01
        comp.Parent = som
    end
end

local function removerAjuste(som)
    if som:IsA("Sound") then
        local marcador = som:FindFirstChild("Configurado")
        if marcador then marcador:Destroy() end
        
        local eq = som:FindFirstChild("CustomEQ")
        if eq then eq:Destroy() end

        local comp = som:FindFirstChild("CustomComp")
        if comp then comp:Destroy() end
    end
end

local function alternarAudioPro()
    if audioAtivo then
        for _, v in pairs(game:GetDescendants()) do
            aplicarAjuste(v)
        end
    else
        for _, v in pairs(game:GetDescendants()) do
            removerAjuste(v)
        end
    end
end

game.DescendantAdded:Connect(function(v)
    if audioAtivo then
        aplicarAjuste(v)
    end
end)

