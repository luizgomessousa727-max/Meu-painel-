local function criarBotao(nome, order)
    local btnFrame = Instance.new("Frame", scroll)
    btnFrame.Size = UDim2.new(1, -6, 0, 36)
    btnFrame.BackgroundColor3 = Color3.fromRGB(24, 28, 35)
    btnFrame.BorderSizePixel = 0
    btnFrame.LayoutOrder = order

    local btnCorner = Instance.new("UICorner", btnFrame)
    btnCorner.CornerRadius = UDim.new(0, 6)

    local btnStroke = Instance.new("UIStroke", btnFrame)
    btnStroke.Thickness = 1
    btnStroke.Color = Color3.fromRGB(38, 44, 54)

    local btn = Instance.new("TextButton", btnFrame)
    btn.Size = UDim2.new(1, -30, 1, 0)
    btn.Position = UDim2.new(0, 10, 0, 0)
    btn.BackgroundTransparency = 1
    btn.Text = nome
    btn.TextColor3 = Color3.fromRGB(200, 205, 215)
    btn.Font = Enum.Font.GothamMedium
    btn.TextSize = 11
    btn.TextXAlignment = Enum.TextXAlignment.Left

    local toggleBg = Instance.new("Frame", btnFrame)
    toggleBg.Size = UDim2.new(0, 26, 0, 14)
    toggleBg.Position = UDim2.new(1, -32, 0.5, -7)
    toggleBg.BackgroundColor3 = Color3.fromRGB(40, 46, 56)
    
    local toggleCorner = Instance.new("UICorner", toggleBg)
    toggleCorner.CornerRadius = UDim.new(1, 0)

    local toggleDot = Instance.new("Frame", toggleBg)
    toggleDot.Size = UDim2.new(0, 10, 0, 10)
    toggleDot.Position = UDim2.new(0, 2, 0.5, -5)
    toggleDot.BackgroundColor3 = Color3.fromRGB(160, 165, 175)

    local dotCorner = Instance.new("UICorner", toggleDot)
    dotCorner.CornerRadius = UDim.new(1, 0)

    return btn, btnFrame, btnStroke, toggleBg, toggleDot
end

